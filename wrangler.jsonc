{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dshmarketplace",
  "main": ".open-next/worker.js",

  // nodejs_compat is required by the OpenNext adapter; the compatibility date
  // must be 2024-09-23 or later for it to resolve to the v2 implementation.
  // global_fetch_strictly_public makes same-zone fetches go out through the
  // public internet, which is what Next's own fetch caching assumes.
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Five admin login attempts per minute per IP. `period` accepts only 10 or
  // 60. The namespace id is an arbitrary label scoped to this Worker, not an
  // account resource — nothing needs provisioning for it.
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  // The zone is already on Cloudflare nameservers, so a custom-domain route
  // provisions the hostname and its certificate directly.
  "routes": [{ "pattern": "dshmarketplace.dev", "custom_domain": true }]

  // Added once the base deploy is green:
  //
  // "r2_buckets": [
  //   { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "dshmarketplace-cache" }
  // ]
  //
  // Cron lives in the separate `sync` Worker rather than here — the OpenNext
  // entry owns `fetch` and wrapping it to add `scheduled` is more fragile than
  // running the catalog sync as its own Worker against the same Turso database.
}
